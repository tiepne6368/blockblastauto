          namespace BBAuto {

          class TouchSynthesizer {
          public:
              TouchSynthesizer() {}

              void executeDragMove(
                  UIWindow* targetWindow,
                  const PlacementMove& move,
                  const CalibrationConfig& config,
                  dispatch_block_t completion
              ) {
                  if (!targetWindow) {
                      if (completion) completion();
                      return;
                  }

                  CGSize winSize = targetWindow.bounds.size;
                  CGFloat startX = move.piece.centerNormX * winSize.width;
                  CGFloat startY = move.piece.centerNormY * winSize.height;

                  CGFloat boardX = config.boardX * winSize.width;
                  CGFloat boardY = config.boardY * winSize.height;
                  CGFloat boardActualW = config.boardW * winSize.width;
                  CGFloat cellW  = boardActualW / 8.0;
                  CGFloat cellH  = boardActualW / 8.0;

                  CGFloat targetPieceCenterX = boardX + (move.targetCol + move.piece.cols * 0.5) * cellW;
                  CGFloat targetPieceCenterY = boardY + (move.targetRow + move.piece.rows * 0.5) * cellH;

                  // Tinh toa do ngon tay ket thuc co bu he so nhay keo (dragGain ~ 1.25x) va khoa bien man hinh
                  CGFloat gainX = std::max(0.5f, config.dragGainX);
                  CGFloat gainY = std::max(0.5f, config.dragGainY);

                  CGFloat rawEndX = startX + (targetPieceCenterX - startX) / gainX;
                  CGFloat rawEndY = startY + ((targetPieceCenterY + config.dragLiftOffsetY) - startY) / gainY;

                  CGFloat endX = std::clamp<double>(rawEndX, 24.0, winSize.width - 24.0);
                  CGFloat endY = std::clamp<double>(rawEndY, 60.0, winSize.height - 40.0);

                  CGPoint startPt = CGPointMake(startX, startY);
                  CGPoint endPt   = CGPointMake(endX, endY);

                  int totalSteps = static_cast<int>(std::round(28.0 / std::clamp(config.dragSpeedMultiplier, 0.3f, 2.0f)));
                  totalSteps = std::clamp(totalSteps, 14, 65);
                  double stepIntervalSec = 0.014;

                  dispatch_async(dispatch_get_main_queue(), ^{
                      dispatchSingleTouchPhase(targetWindow, startPt, UITouchPhaseBegan);

                      for (int step = 1; step <= totalSteps; ++step) {
                          double delaySec = step * stepIntervalSec;
                          dispatch_after(
                              dispatch_time(DISPATCH_TIME_NOW, static_cast<int64_t>(delaySec * NSEC_PER_SEC)),
                              dispatch_get_main_queue(),
                              ^{
                                  double t = static_cast<double>(step) / totalSteps;
                                  double easedT = 1.0 - std::pow(1.0 - t, 2.5);
                                  CGPoint curPt = CGPointMake(
                                      startPt.x + (endPt.x - startPt.x) * easedT,
                                      startPt.y + (endPt.y - startPt.y) * easedT
                                  );
                                  dispatchSingleTouchPhase(targetWindow, curPt, UITouchPhaseMoved);
                              }
                          );
                      }

                      double holdTimeSec = (totalSteps * stepIntervalSec) + 0.12;
                      dispatch_after(
                          dispatch_time(DISPATCH_TIME_NOW, static_cast<int64_t>(holdTimeSec * NSEC_PER_SEC)),
                          dispatch_get_main_queue(),
                          ^{
                              dispatchSingleTouchPhase(targetWindow, endPt, UITouchPhaseEnded);
                              if (completion) completion();
                          }
                      );
                  });
              }

          private:
              void dispatchSingleTouchPhase(UIWindow* window, CGPoint pointInWindow, UITouchPhase phase) {
                  if (!window) return;
                  static UITouch* activeTouch = nil;
                  static UIView* targetHitView = nil;

                  if (phase == UITouchPhaseBegan || activeTouch == nil) {
                      activeTouch = [[UITouch alloc] init];
                      targetHitView = [window hitTest:pointInWindow withEvent:nil] ?: window.rootViewController.view ?: window;

                      if ([activeTouch respondsToSelector:@selector(setWindow:)]) [activeTouch setWindow:window];
                      if ([activeTouch respondsToSelector:@selector(setView:)]) [activeTouch setView:targetHitView];
                      if ([activeTouch respondsToSelector:@selector(setTapCount:)]) [activeTouch setTapCount:1];
                      if ([activeTouch respondsToSelector:@selector(_setIsFirstTouchForView:)]) [activeTouch _setIsFirstTouchForView:YES];
                      if ([activeTouch respondsToSelector:@selector(_setLocationInWindow:resetPrevious:)]) {
                          [activeTouch _setLocationInWindow:pointInWindow resetPrevious:YES];
                      }
                  } else {
                      if ([activeTouch respondsToSelector:@selector(_setLocationInWindow:resetPrevious:)]) {
                          [activeTouch _setLocationInWindow:pointInWindow resetPrevious:NO];
                      }
                  }

                  if ([activeTouch respondsToSelector:@selector(setPhase:)]) [activeTouch setPhase:phase];
                  if ([activeTouch respondsToSelector:@selector(setTimestamp:)]) {
                      [activeTouch setTimestamp:[[NSProcessInfo processInfo] systemUptime]];
                  }

                  UIEvent* touchesEvent = nil;
                  if ([[UIApplication sharedApplication] respondsToSelector:NSSelectorFromString(@"_touchesEvent")]) {
                      touchesEvent = [[UIApplication sharedApplication] valueForKey:@"_touchesEvent"];
                  }
                  if (touchesEvent && [touchesEvent respondsToSelector:@selector(_addTouch:forDelayedDelivery:)]) {
                      if ([touchesEvent respondsToSelector:@selector(_clearTouches)]) [touchesEvent _clearTouches];
                      [touchesEvent _addTouch:activeTouch forDelayedDelivery:NO];
                  }

                  NSSet<UITouch*>* touchSet = [NSSet setWithObject:activeTouch];
                  if (targetHitView) {
                      if (phase == UITouchPhaseBegan) [targetHitView touchesBegan:touchSet withEvent:touchesEvent];
                      else if (phase == UITouchPhaseMoved) [targetHitView touchesMoved:touchSet withEvent:touchesEvent];
                      else if (phase == UITouchPhaseEnded) [targetHitView touchesEnded:touchSet withEvent:touchesEvent];
                      else if (phase == UITouchPhaseCancelled) [targetHitView touchesCancelled:touchSet withEvent:touchesEvent];
                  }

                  if (phase == UITouchPhaseEnded || phase == UITouchPhaseCancelled) {
                      if (touchesEvent && [touchesEvent respondsToSelector:@selector(_clearTouches)]) {
                          [touchesEvent _clearTouches];
                      }
                      activeTouch = nil;
                      targetHitView = nil;
                  }
              }
          };


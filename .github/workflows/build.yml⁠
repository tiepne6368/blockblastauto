          @interface BBCalibrationGuideView : UIView
          @property (nonatomic, assign) BBAuto::CalibrationConfig currentConfig;
          @property (nonatomic, assign) BBAuto::RuntimeTelemetry currentTelemetry;
          @property (nonatomic, assign) BBAuto::EngineRunState currentRunState;
          @end

          @implementation BBCalibrationGuideView
          - (instancetype)initWithFrame:(CGRect)frame {
              if (self = [super initWithFrame:frame]) {
                  self.backgroundColor = [UIColor clearColor];
                  self.userInteractionEnabled = NO;
              }
              return self;
          }

          - (void)drawRect:(CGRect)rect {
              CGContextRef ctx = UIGraphicsGetCurrentContext();
              CGSize sz = self.bounds.size;

              CGFloat boardPxW = _currentConfig.boardW * sz.width;
              CGRect boardRect = CGRectMake(
                  _currentConfig.boardX * sz.width,
                  _currentConfig.boardY * sz.height,
                  boardPxW,
                  boardPxW
              );
              CGFloat cellW = boardRect.size.width / 8.0;
              CGFloat cellH = boardRect.size.height / 8.0;

              CGRect dockRect = CGRectMake(
                  _currentConfig.dockX * sz.width,
                  _currentConfig.dockY * sz.height,
                  _currentConfig.dockW * sz.width,
                  _currentConfig.dockH * sz.height
              );
              CGFloat slotW = dockRect.size.width / 3.0;

              // 1. Neu bat nut Khung: Ve luoi ban choi 8x8 va cham xanh o da co gach
              if (_currentConfig.showCalibrationOverlay) {
                  CGContextSetStrokeColorWithColor(ctx, [UIColor colorWithRed:0.1f green:0.95f blue:0.4f alpha:0.85f].CGColor);
                  CGContextSetLineWidth(ctx, 1.8);
                  CGContextStrokeRect(ctx, boardRect);

                  CGContextSetLineWidth(ctx, 0.6);
                  for (int i = 1; i < 8; ++i) {
                      CGContextMoveToPoint(ctx, boardRect.origin.x + i * cellW, boardRect.origin.y);
                      CGContextAddLineToPoint(ctx, boardRect.origin.x + i * cellW, CGRectGetMaxY(boardRect));
                      CGContextMoveToPoint(ctx, boardRect.origin.x, boardRect.origin.y + i * cellH);
                      CGContextAddLineToPoint(ctx, CGRectGetMaxX(boardRect), boardRect.origin.y + i * cellH);
                  }
                  CGContextStrokePath(ctx);

                  CGContextSetFillColorWithColor(ctx, [UIColor colorWithRed:0.1f green:1.0f blue:0.3f alpha:0.9f].CGColor);
                  for (int r = 0; r < 8; ++r) {
                      for (int c = 0; c < 8; ++c) {
                          if ((_currentTelemetry.lastDetectedBoard >> (r * 8 + c)) & 1ULL) {
                              CGFloat cx = boardRect.origin.x + (c + 0.5) * cellW;
                              CGFloat cy = boardRect.origin.y + (r + 0.5) * cellH;
                              CGContextFillEllipseInRect(ctx, CGRectMake(cx - 4.5, cy - 4.5, 9.0, 9.0));
                          }
                      }
                  }

                  CGContextSetStrokeColorWithColor(ctx, [UIColor colorWithRed:1.0f green:0.75f blue:0.1f alpha:0.85f].CGColor);
                  CGContextSetLineWidth(ctx, 1.8);
                  CGContextStrokeRect(ctx, dockRect);

                  for (int s = 0; s < 3; ++s) {
                      if (s > 0) {
                          CGContextMoveToPoint(ctx, dockRect.origin.x + s * slotW, dockRect.origin.y);
                          CGContextAddLineToPoint(ctx, dockRect.origin.x + s * slotW, CGRectGetMaxY(dockRect));
                          CGContextStrokePath(ctx);
                      }
                      const auto& piece = _currentTelemetry.lastDetectedDock[s];
                      if (piece.valid) {
                          NSString* label = [NSString stringWithFormat:@"%dx%d (%d)", piece.rows, piece.cols, piece.cellCount];
                          NSDictionary* attrs = @{
                              NSFontAttributeName: [UIFont boldSystemFontOfSize:11.0],
                              NSForegroundColorAttributeName: [UIColor greenColor]
                          };
                          [label drawAtPoint:CGPointMake(dockRect.origin.x + s * slotW + 6, dockRect.origin.y + 4) withAttributes:attrs];
                      }
                  }
              }

              // 2. VE HINH MO PHONG KHOI O DOCK VA VI TRI DAT TREN BAN CO (KHI BAT HDAN CHOI HOAC AUTO)
              if (_currentTelemetry.hasActiveGuideMove && _currentTelemetry.currentGuideMove.valid) {
                  const auto& mv = _currentTelemetry.currentGuideMove;
                  int slot = mv.slotIndex;

                  // 2a. Dong khung sang khay Dock can keo + ve mo phong khoi nho trong Dock
                  if (slot >= 0 && slot < 3) {
                      CGRect activeSlotRect = CGRectMake(
                          dockRect.origin.x + slot * slotW + 4,
                          dockRect.origin.y + 4,
                          slotW - 8,
                          dockRect.size.height - 8
                      );
                      CGContextSetStrokeColorWithColor(ctx, [UIColor cyanColor].CGColor);
                      CGContextSetLineWidth(ctx, 3.0);
                      CGContextStrokeRect(ctx, activeSlotRect);

                      NSString* slotBadge = [NSString stringWithFormat:@"BƯỚC %d/%d: LẤY KHỐI NÀY",
                                             _currentTelemetry.guideStepIndex + 1,
                                             std::max(1, _currentTelemetry.guideTotalSteps)];
                      NSDictionary* badgeAttrs = @{
                          NSFontAttributeName: [UIFont boldSystemFontOfSize:10.5],
                          NSForegroundColorAttributeName: [UIColor yellowColor],
                          NSBackgroundColorAttributeName: [UIColor colorWithWhite:0.0 alpha:0.75]
                      };
                      [slotBadge drawAtPoint:CGPointMake(activeSlotRect.origin.x + 4, activeSlotRect.origin.y - 16)
                              withAttributes:badgeAttrs];
                  }

                  // 2b. Ve hinh mo phong cua khoi truc tiep len cac o dich tren ban co 8x8
                  for (int r = 0; r < mv.piece.rows; ++r) {
                      for (int c = 0; c < mv.piece.cols; ++c) {
                          if (!mv.piece.getCell(r, c)) continue;
                          int br = mv.targetRow + r;
                          int bc = mv.targetCol + c;
                          if (br < 0 || br >= 8 || bc < 0 || bc >= 8) continue;

                          CGRect cellRect = CGRectMake(
                              boardRect.origin.x + bc * cellW + 2.0,
                              boardRect.origin.y + br * cellH + 2.0,
                              cellW - 4.0,
                              cellH - 4.0
                          );

                          // To mau nen khoi mo phong (Cyan sang pha Vang neu an hang)
                          if (mv.linesCleared > 0) {
                              CGContextSetFillColorWithColor(ctx, [UIColor colorWithRed:1.0f green:0.85f blue:0.1f alpha:0.58f].CGColor);
                              CGContextSetStrokeColorWithColor(ctx, [UIColor yellowColor].CGColor);
                          } else {
                              CGContextSetFillColorWithColor(ctx, [UIColor colorWithRed:0.0f green:0.95f blue:1.0f alpha:0.52f].CGColor);
                              CGContextSetStrokeColorWithColor(ctx, [UIColor cyanColor].CGColor);
                          }

                          UIBezierPath* rounded = [UIBezierPath bezierPathWithRoundedRect:cellRect cornerRadius:5.0];
                          [rounded fill];
                          rounded.lineWidth = 2.4;
                          [rounded stroke];
                      }
                  }

                  // 2c. Ve duong mui ten chi dan tu khay Dock len tam vi tri dat tren ban co
                  CGFloat startX = (mv.piece.centerNormX > 0.01f)
                      ? (mv.piece.centerNormX * sz.width)
                      : (dockRect.origin.x + (slot + 0.5) * slotW);
                  CGFloat startY = (mv.piece.centerNormY > 0.01f)
                      ? (mv.piece.centerNormY * sz.height)
                      : (dockRect.origin.y + dockRect.size.height * 0.5);

                  CGFloat targetCenterX = boardRect.origin.x + (mv.targetCol + mv.piece.cols * 0.5) * cellW;
                  CGFloat targetCenterY = boardRect.origin.y + (mv.targetRow + mv.piece.rows * 0.5) * cellH;

                  CGContextSaveGState(ctx);
                  CGContextSetStrokeColorWithColor(ctx, [UIColor colorWithRed:1.0f green:1.0f blue:0.2f alpha:0.9f].CGColor);
                  CGContextSetLineWidth(ctx, 2.2);
                  CGFloat dashLengths[] = {6.0, 4.0};
                  CGContextSetLineDash(ctx, 0, dashLengths, 2);
                  CGContextMoveToPoint(ctx, startX, startY);
                  CGContextAddLineToPoint(ctx, targetCenterX, targetCenterY);
                  CGContextStrokePath(ctx);
                  CGContextRestoreGState(ctx);

                  // Nhan hien thi ngay tren khoi mo phong tren ban co
                  NSString* targetTag = [NSString stringWithFormat:@"ĐẶT %d/%d (%d,%d)",
                                         _currentTelemetry.guideStepIndex + 1,
                                         std::max(1, _currentTelemetry.guideTotalSteps),
                                         mv.targetRow + 1,
                                         mv.targetCol + 1];
                  NSDictionary* tagAttrs = @{
                      NSFontAttributeName: [UIFont boldSystemFontOfSize:11.0],
                      NSForegroundColorAttributeName: [UIColor whiteColor],
                      NSBackgroundColorAttributeName: [UIColor colorWithRed:0.0f green:0.35f blue:0.65f alpha:0.88f]
                  };
                  [targetTag drawAtPoint:CGPointMake(
                      boardRect.origin.x + mv.targetCol * cellW + 2,
                      std::max<CGFloat>(boardRect.origin.y, boardRect.origin.y + mv.targetRow * cellH - 16)
                  ) withAttributes:tagAttrs];

                  // 2d. Ve vien net dut mo cho Buoc tiep theo (neu co) de ban biet truoc
                  if (_currentTelemetry.nextGuideMove.valid) {
                      const auto& nextMv = _currentTelemetry.nextGuideMove;
                      CGContextSaveGState(ctx);
                      CGContextSetStrokeColorWithColor(ctx, [UIColor colorWithWhite:1.0 alpha:0.55].CGColor);
                      CGContextSetLineWidth(ctx, 1.4);
                      CGFloat nextDash[] = {3.0, 3.0};
                      CGContextSetLineDash(ctx, 0, nextDash, 2);
                      for (int r = 0; r < nextMv.piece.rows; ++r) {
                          for (int c = 0; c < nextMv.piece.cols; ++c) {
                              if (!nextMv.piece.getCell(r, c)) continue;
                              int br = nextMv.targetRow + r;
                              int bc = nextMv.targetCol + c;
                              CGRect cr = CGRectMake(
                                  boardRect.origin.x + bc * cellW + 4.0,
                                  boardRect.origin.y + br * cellH + 4.0,
                                  cellW - 8.0,
                                  cellH - 8.0
                              );
                              CGContextStrokeRect(ctx, cr);
                          }
                      }
                      CGContextRestoreGState(ctx);
                  }
              }
          }
          @end


          @interface UITouch (PrivateSynthesize)
          - (void)setPhase:(UITouchPhase)phase;
          - (void)setTapCount:(NSUInteger)tapCount;
          - (void)setWindow:(UIWindow *)window;
          - (void)setView:(UIView *)view;
